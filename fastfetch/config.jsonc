// fastfetch/config.jsonc - a compact greeting when a terminal starts.
// Installed by setup-dotFiles.sh as ~/.config/fastfetch/config.jsonc.
// Modules: fastfetch --list-modules; presets: fastfetch --list-presets
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "cyan" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": " os" },
    { "type": "kernel",   "key": " kernel" },
    { "type": "uptime",   "key": "󰅐 uptime" },
    { "type": "shell",    "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu",      "key": " cpu" },
    { "type": "gpu",      "key": "󰢮 gpu" },
    { "type": "memory",   "key": "󰍛 mem" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/" },
    { "type": "localip",  "key": "󰩟 ip", "showIpv6": false },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
