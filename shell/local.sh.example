# export QUARTUS_ROOTDIR="$QROOT/quartus"
# export QSYS_ROOTDIR="$QUARTUS_ROOTDIR/sopc_builder/bin"
# path_append "$QUARTUS_ROOTDIR/bin"
# path_append "$QROOT/questa_fse/bin"
