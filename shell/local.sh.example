# shellcheck shell=sh
# ===========================================================================
#  ~/.config/shell/local.sh - settings for THIS machine only
#
#  Sourced last by bashrc and zshrc, after everything setup-dotFiles.sh
#  installs. setup-dotFiles.sh copies this example only when local.sh does
#  not exist yet, and never overwrites it. Keep it out of version control.
#
#  path_prepend and path_append come from env.sh.
# ===========================================================================

# --- example: Intel Quartus Prime Lite + Questa FSE --------------------------
