#!/usr/bin/env bash
# ===========================================================================
#  autoeq - AutoEq profile switcher for PipeWire (filter-chain convolver)
#  Installed by setup-dotFiles.sh into ~/.local/bin.
#
#      autoeq D5200 | D7200 | D9200    put the EQ in front of the headphones
#      autoeq off                      remove it
#      autoeq status                   what is active, and where it plays
#      autoeq sinks                    the outputs it could play to
#
#  The headphone output is $AUTOEQ_SINK when set (see `autoeq sinks`),
#  otherwise the onboard analog output (alsa_output.pci-*.analog-stereo),
#  otherwise the first analog output that is not HDMI.
# ===========================================================================
set -euo pipefail
DIR="$HOME/.local/share/autoeq/denon"
CONF="$HOME/.config/pipewire/pipewire.conf.d/97-autoeq.conf"

analog_sinks() {
    pactl list short sinks 2>/dev/null \
        | awk '$2 ~ /^alsa_output\..*analog-stereo$/ && $2 !~ /hdmi/ {print $2}'
}

pick_sink() {
    if [[ -n ${AUTOEQ_SINK:-} ]]; then
        printf '%s\n' "$AUTOEQ_SINK"
        return
    fi
    local all
    all="$(analog_sinks)"
    grep -m1 '^alsa_output\.pci-' <<<"$all" || head -n1 <<<"$all"
}

restart_audio() {
    systemctl --user restart pipewire pipewire-pulse wireplumber
    sleep 2
}

case "${1:-status}" in
  status)
    if [[ -f "$CONF" ]]; then
      grep -o 'Denon_AH-[A-Z0-9]*' "$CONF" | head -1 | sed 's/^/AutoEq active: /'
      grep -o 'target.object *= *"[^"]*"' "$CONF" | sed 's/.*"\(.*\)"/plays to: \1/'
    else
      echo "AutoEq: off"
    fi
    echo -n "default sink: "; pactl get-default-sink 2>/dev/null || echo "?"
    exit 0
    ;;
  sinks)
    analog_sinks
    echo "pick one with: AUTOEQ_SINK=<name> autoeq D5200" >&2
    exit 0
    ;;
  off)
    sink="$(pick_sink)"
    rm -f "$CONF"
    restart_audio
    [[ -n $sink ]] && pactl set-default-sink "$sink" 2>/dev/null || true
    echo "AutoEq: OFF (default sink -> ${sink:-unchanged})"
    exit 0
    ;;
esac

M="Denon_AH-${1#AH-}"
IR="$DIR/${M}_48000.wav"
[[ -f "$IR" ]] || { echo "No such profile: $IR" >&2; exit 1; }
SINK="$(pick_sink)"
[[ -n $SINK ]] || { echo "No analog output found - see: autoeq sinks" >&2; exit 1; }
mkdir -p "$(dirname "$CONF")"

cat > "$CONF" <<CONF
# AutoEq: $M (oratory1990 measurements). Preamp is already baked into the IR.
# Generated by 'autoeq'. Run 'autoeq off' to disable.
context.modules = [
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "AutoEq $M"
      media.name       = "AutoEq $M"
      filter.graph = {
        nodes = [
          { type = builtin label = convolver name = cL config = { filename = "$IR" channel = 0 } }
          { type = builtin label = convolver name = cR config = { filename = "$IR" channel = 1 } }
        ]
        inputs  = [ "cL:In"  "cR:In"  ]
        outputs = [ "cL:Out" "cR:Out" ]
      }
      capture.props = {
        node.name        = "autoeq_sink"
        node.description = "AutoEq $M"
        media.class      = Audio/Sink
        audio.channels   = 2
        audio.position   = [ FL FR ]
        priority.session = 2000
      }
      playback.props = {
        node.name      = "autoeq_out"
        node.passive   = true
        target.object  = "$SINK"
        audio.channels = 2
        audio.position = [ FL FR ]
      }
    }
  }
]
CONF

restart_audio
pactl set-default-sink autoeq_sink 2>/dev/null || true
echo "AutoEq: $M on $SINK (default sink -> autoeq_sink)"
